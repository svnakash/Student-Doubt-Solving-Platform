# Local development environment template
# Copy to backend/.env and replace the placeholder secrets.
# Never commit backend/.env to GitHub.

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters-long

# Optional: defaults to a local SQLite database.
# DATABASE_URL=sqlite:///instance/app.db

# Optional: configure a shared rate-limit store for production.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# AI integration (server-side only; keep API keys out of frontend code)
AI_ENABLED=false
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
